; Abyss of Tears — Godot 4.6.3
config_version=5
[application]
config/name="Abyss of Tears"
config/version="0.13.0"
run/max_fps=60
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/sprites/icon.svg"
[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.07, 1)
[autoload]
Settings="*res://scripts/saving/settings.gd"
Progress="*res://scripts/saving/progress.gd"
RunSave="*res://scripts/saving/run_save.gd"
Soundscape="*res://scripts/audio/soundscape.gd"
[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
